# Copia este archivo como .env y rellena tu token.
#
# Token clasico (recomendado):  https://github.com/settings/tokens/new
#   Scope necesario: repo   (incluye public_repo, issues y pull requests)
#   Si ademas quieres borrar el repo sandbox al terminar: delete_repo
#
# El archivo .env esta en .gitignore. NUNCA lo subas a GitHub.
GITHUB_TOKEN=ghp_pon_aqui_tu_token

# Opcionales: sobreescriben los valores por defecto del CLI
# ARCHIVAMENTS_REPO=archivaments-lab
# ARCHIVAMENTS_DELAY_MS=1200
